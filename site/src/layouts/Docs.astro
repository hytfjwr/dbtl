---
import type { MarkdownHeading } from "astro";
import PrevNext from "../components/PrevNext.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import { neighbours, type Nav, type NavPage } from "../lib/nav.ts";
import { editUrl, VERSION } from "../lib/site.ts";
import { tocItems } from "../lib/toc.ts";
import Base from "./Base.astro";

interface Props {
  page: NavPage;
  nav: Nav;
  headings: MarkdownHeading[];
}
const { page, nav, headings } = Astro.props;
const { prev, next } = neighbours(nav, page.slug);
const generated = page.kind === "reference";

// A generated page with a few sections gets a wide column and a row of chips in
// place of the right-hand list. One with many sections (a page per rule) keeps the
// list: a row of dozens of chips would be harder to use than the list.
const CHIP_LIMIT = 8;
const sections = headings.filter((h) => h.depth === 2);
const chips = generated && sections.length > 0 && sections.length <= CHIP_LIMIT;
const items = tocItems(headings);
---

<Base title={`${page.title} - dbtl docs`} description={page.description} section="docs">
  <div class="docs" data-page={chips ? "reference" : "docs"}>
    <div class="docbar">
      <button type="button" id="open-drawer" aria-controls="sidebar" aria-expanded="false">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
        Menu
      </button>
      <span>
        {page.group} / {page.title}
      </span>
    </div>

    <Sidebar nav={nav} current={page.slug} />

    <div class="doc-main vt-page">
      <article
        class={chips ? "article wide" : "article"}
        data-pagefind-body
        data-pagefind-meta={`section:${page.group}`}
      >
        <div class="crumb" data-pagefind-ignore>
          <span>{page.group}</span>
          <span aria-hidden="true">/</span>
          <span>{page.title}</span>
          <span class="badge">v{VERSION}</span>
          {generated && <span class="badge">generated</span>}
        </div>
        <h1>{page.title}</h1>
        {!generated && <p class="lead">{page.description}</p>}
        {chips && (
          <nav class="jump" aria-label="On this page" data-pagefind-ignore>
            <span>On this page</span>
            {sections.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        )}
        {!chips && items.length > 0 && (
          <details class="toc-drop" data-pagefind-ignore>
            <summary>On this page</summary>
            <ul>
              {items.map((i) => (
                <li data-depth={i.depth}>
                  <a href={`#${i.slug}`}>{i.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}
        {generated && (
          <aside class="pane adm note" data-pagefind-ignore>
            <p class="pane-title">note</p>
            <p>
              This page is generated from the source. To change it, edit the source and run{" "}
              <code>cargo xtask gen-docs</code>.
            </p>
          </aside>
        )}
        <slot />
        <PrevNext prev={prev} next={next} />
        <div class="meta" data-pagefind-ignore>
          {generated ? (
            <span>
              Generated by <code>cargo xtask gen-docs</code>.
            </span>
          ) : (
            <a href={editUrl(page.id)}>Edit this page</a>
          )}
          <span>Applies to v{VERSION}</span>
        </div>
      </article>
    </div>

    {!chips && <Toc items={items} />}
  </div>
  <script>
    import "../scripts/toc.ts";
  </script>
</Base>
