{
  "name": "dbtl-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prebuild.mjs && astro dev",
    "data:graph": "node scripts/prebuild.mjs",
    "data:lint": "node scripts/lint-data.mjs",
    "build": "node scripts/prebuild.mjs && astro build && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs",
    "check:selectors": "node scripts/check-selectors.mjs",
    "format": "oxfmt && rumdl fmt",
    "format:check": "oxfmt --check && rumdl fmt --check",
    "lint": "oxlint && rumdl check",
    "check": "node scripts/prebuild.mjs && astro check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.4",
    "github-slugger": "2.0.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@playwright/test": "1.64.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pagefind": "1.5.2",
    "rumdl": "0.3.2",
    "typescript": "6.0.3",
    "vfile": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.16.1"
}
