---
import Commands from "../components/home/Commands.astro";
import Demo from "../components/home/Demo.astro";
import Features from "../components/home/Features.astro";
import Hero from "../components/home/Hero.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="dbtl — a terminal UI for dbt model lineage"
  description="dbtl draws your dbt project's dependency graph in a terminal UI. See what a model depends on and what it affects without running dbt compile or opening a browser."
  section="home"
>
  <div class="wrap vt-page" data-pagefind-body data-pagefind-meta="section:Home">
    <Hero>
      <Demo />
    </Hero>
    <Features />
    <Commands />
  </div>
</Base>
