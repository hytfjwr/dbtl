---
import type { TocItem } from "../lib/toc.ts";

interface Props {
  items: TocItem[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="pane toc" aria-label="On this page">
      <p class="pane-title">On this page</p>
      <ul id="toc">
        <li class="toc-ink" id="toc-ink" role="presentation" aria-hidden="true" />
        {items.map((i) => (
          <li data-depth={i.depth}>
            <a href={`#${i.slug}`} title={i.text}>{i.text}</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
